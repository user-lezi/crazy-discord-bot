{
  "name": "crazy-discord-bot",
  "version": "1.0.0",
  "description": "crazy",
  "homepage": "https://github.com/user-lezi/crazy-discord-bot#readme",
  "bugs": {
    "url": "https://github.com/user-lezi/crazy-discord-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-lezi/crazy-discord-bot.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "",
  "type": "commonjs",
  "main": "bot.js",
  "scripts": {
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=bot.js --minify --packages=external --legal-comments=none --tree-shaking=true --analyze && npm run compress",
    "compress": "node scripts/uglify.js",
    "bot": "npm run build && node .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('bot.js',{force:true})\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@types/node": "^26.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "ollama": "^0.6.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "uglify-js": "^3.19.3"
  }
}
